"<td>language name</td>"
"<td>%{n} or %{lang_name}</td></tr>"
"<tr>"
"<td>%a</td>"
"<td>audio format (on the Video DVD)</td>"
"<td>%{a} or %{audio_format}</td></tr>"
"<tr>"
"<td>%c</td>"
"<td>number of audio channels (on the Video DVD)</td>"
"<td>%{c} or %{channels}</td></tr>"
"<tr>"
