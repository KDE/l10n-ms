#: rc.cpp:252
#, no-c-format
msgid ""
"<p>With amaroK you can use the window layout that you find most comfortable."
"</p>\n"
"<p>You can change these settings at a later time using the configuration "
"dialog.</p>"
msgstr ""

#. i18n: file ./firstrunwizard.ui line 273
#: rc.cpp:257
#, no-c-format
