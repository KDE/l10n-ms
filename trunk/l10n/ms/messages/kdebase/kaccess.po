#: kaccess.cpp:670
msgid "Do you really want to deactivate \"%1\"?"
msgstr "Adakah anda pasti mahu mematikan \"%1\"?"

#: kaccess.cpp:673
msgid "Do you really want to deactivate \"%1\" and \"%2\"?"
msgstr "Adakah anda pasti mahu mematikan \"%1\" dan \"%2\"?"

