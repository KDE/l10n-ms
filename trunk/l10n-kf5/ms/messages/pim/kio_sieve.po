#: sieve.cpp:339
#, kde-format
msgid "Connecting to %1..."
msgstr "Menyambung ke %1..."

#: sieve.cpp:342
#, kde-format
msgid "The connection to the server was lost."
msgstr "Sambungan ke pelayan hilang."

#: sieve.cpp:354
#, kde-format
msgid "Server identification failed."
msgstr "Identifikasi pelayan gagal."

#: sieve.cpp:360
#, kde-format
msgid "Can not use TLS since the underlying Qt library does not support it."
msgstr ""

#: sieve.cpp:367
#, kde-format
msgid ""
"TLS encryption was requested, but your Sieve server does not advertise TLS "
"in its capabilities.\n"
"You can choose to try to initiate TLS negotiations nonetheless, or cancel "
"the operation."
msgstr ""

#: sieve.cpp:369
#, kde-format
msgid "Server Does Not Advertise TLS"
msgstr ""

#: sieve.cpp:369
#, kde-format
msgid "&Start TLS nonetheless"
msgstr ""

#: sieve.cpp:369
#, kde-format
msgid "&Cancel"
msgstr "&Batal"

#: sieve.cpp:370
#, kde-format
msgid "TLS encryption requested, but not supported by server."
msgstr ""

#: sieve.cpp:391
#, kde-format
msgid ""
"Your Sieve server claims to support TLS, but negotiation was unsuccessful."
msgstr ""

#: sieve.cpp:393
#, kde-format
msgid "Connection Failed"
msgstr "Sambungan Gagal"

#: sieve.cpp:400
#, kde-format
msgid ""
"The server does not seem to support TLS. Disable TLS if you want to connect "
"without encryption."
msgstr ""

#: sieve.cpp:412
#, kde-format
msgid "Authenticating user..."
msgstr "Mengesahkan pengguna..."

#: sieve.cpp:415
#, kde-format
msgid "Authentication failed."
msgstr "Pengesahan gagal."

#: sieve.cpp:479
#, kde-format
msgctxt "special command completed"
msgid "Done."
msgstr "Selesai."

#: sieve.cpp:492
#, kde-format
msgid "Activating script..."
msgstr "Mengaktifkan skrip..."

#: sieve.cpp:509
#, kde-format
msgid "There was an error activating the script."
msgstr "Ralat berlaku semasa mengaktifkan skrip."

#: sieve.cpp:529
#, kde-format
msgid "There was an error deactivating the script."
msgstr "Ralat berlaku semasa menyahaktifkan skrip."

#: sieve.cpp:561
#, kde-format
msgid "Sending data..."
msgstr "Menghantar data..."

#: sieve.cpp:578
#, kde-format
msgid "KIO data supply error."
msgstr "Ralat bekalan data KIO."

#: sieve.cpp:629 sieve.cpp:1164
#, kde-format
msgid "Network error."
msgstr "Ralat rangkaian."

#: sieve.cpp:641
#, kde-format
msgid "Verifying upload completion..."
msgstr "Mengesahkan penyelesaian muat naik..."

#: sieve.cpp:665 sieve.cpp:672
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"This is probably due to errors in the script.\n"
"The server responded:\n"
"%1"
msgstr ""
"Skrip tidak berjaya dimuat naik.\n"
"Ini mungkin disebabkan ralat dalam skrip.\n"
"Pelayan memberikan respons:\n"
"%1"

#: sieve.cpp:676 sieve.cpp:680
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"The script may contain errors."
msgstr ""
"Skrip tidak berjaya dimuat naik.\n"
"Mungkin skrip mengandungi ralat."

#: sieve.cpp:688
#, kde-format
msgctxt "data upload complete"
msgid "Done."
msgstr "Selesai."

#: sieve.cpp:720
#, kde-format
msgid "Retrieving data..."
msgstr "Mendapatkan semula data..."

#: sieve.cpp:770
#, kde-format
msgid "Finishing up..."
msgstr "Hampir siap..."

#: sieve.cpp:779
#, kde-format
msgid "A protocol error occurred while trying to negotiate script downloading."
msgstr "Ralat protokol semasa cuba runding muat turun skrip. "

#: sieve.cpp:784
#, fuzzy, kde-format
#| msgctxt "special command completed"
#| msgid "Done."
msgctxt "data retrieval complete"
msgid "Done."
msgstr "Selesai."

#: sieve.cpp:791
#, kde-format
msgid "Folders are not supported."
msgstr "Folder tidak disokong."

#: sieve.cpp:800
#, kde-format
msgid "Deleting file..."
msgstr "Menghapuskan fail..."

#: sieve.cpp:816
#, kde-format
msgid "The server would not delete the file."
msgstr "Pelayan tidak akan menghapuskan fail."

#: sieve.cpp:820
#, fuzzy, kde-format
#| msgid "Done."
msgctxt "file removal complete"
msgid "Done."
msgstr "Selesai."

#: sieve.cpp:835
#, kde-format
msgid "Cannot chmod to anything but 0700 (active) or 0600 (inactive script)."
msgstr ""
"Tidak dapat  chmod kepada apapun kecuali  0700 (aktif) atau 0600 (skrip tak "
"aktif)."

#: sieve.cpp:997
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr ""

#: sieve.cpp:1021
#, kde-format
msgid "Sieve Authentication Details"
msgstr "Saring Perincian Pengesahan"

#: sieve.cpp:1022
#, kde-format
msgid ""
"Please enter your authentication details for your sieve account (usually the "
"same as your email password):"
msgstr ""
"Masukkan perincian pengesahan untuk akaun penyaringan anda (biasanya sama "
"dengan kata laluan e-mel):"

#: sieve.cpp:1095
#, kde-format
msgid ""
"A protocol error occurred during authentication.\n"
"Choose a different authentication method to %1."
msgstr ""
"Ralat protokol berlaku semasa pengesahan.\n"
"Pilih kaedah pengesahan yang lain untuk %1."

#: sieve.cpp:1134
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"Pengesahan gagal.\n"
"Kemungkinan besar kata laluan salah.\n"
"Pelayan memberikan respons:\n"
"%1"

#: sieve.cpp:1219
#, kde-format
msgid "A protocol error occurred."
msgstr "Ralat protokol telah berlaku."

#~ msgctxt "data retrival complete"
#~ msgid "Done."
#~ msgstr "Selesai."
