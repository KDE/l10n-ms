"Device busy.\n"
"Perhaps you need to unmount the floppy first."
msgstr ""
"Peranti sibuk.\n"
"Anda mungkin perlu nyahlekapkan cakera liut dahulu."

#: format.cpp:532
#, kde-format
msgid "Low-level format error: %1"
msgstr "Ralat format tahap rendah: %1"

