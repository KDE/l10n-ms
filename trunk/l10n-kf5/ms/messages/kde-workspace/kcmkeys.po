msgstr "Muatkan Skema Pintasan"

#: kglobalshortcutseditor.cpp:561
msgid "Load"
msgstr "Muat"

#: kglobalshortcutseditor.cpp:574
#, kde-format
msgid "This file (%1) does not exist. You can only select local files."
msgstr "Fail ini (%1) tidak wujud. Anda hanya boleh memilih fail tempatan."

