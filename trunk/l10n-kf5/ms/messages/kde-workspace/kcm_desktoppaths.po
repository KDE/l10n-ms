msgid ""
"The path for '%1' has been changed.\n"
"Do you want the files to be moved from '%2' to '%3'?"
msgstr ""
"Laluan bagi '%1' telah diubah;\n"
"Anda ingin fail dialih dari '%2' ke '%3'?"

#: globalpaths.cpp:378
msgctxt "Move files from old to new place"
msgid "Move"
msgstr "Pindah"

#: globalpaths.cpp:379
