msgstr "Fail Diubah"

#: main.cpp:217
#, kde-format
msgid "Do Not Delete"
msgstr "Jangan Padam"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Fail\n"
"%1\n"
"telah diubahsuai.\n"
"Anda mahu muat naik perubahan?"

