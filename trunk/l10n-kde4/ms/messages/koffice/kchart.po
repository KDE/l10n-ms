#: dialogs/KCConfigColorPage.cc:48
msgid ""
"This page lets you configure the colors in which your chart is displayed. "
"Each part of the chart can be assigned a different color."
msgstr ""
"Halaman ini membenarkan anda mengkonfigur warna carta anda apabila "
"dipaparkan. Setiap bahagian carta boleh diumpuk dengan warna yang berbeza."

#: dialogs/KCConfigColorPage.cc:54
msgid "Colors"
msgstr "Warna"

#: dialogs/KCConfigColorPage.cc:61
msgid "&Line color:"
msgstr "Warna &garis:"

#: dialogs/KCConfigColorPage.cc:67
