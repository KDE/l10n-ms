"CONCATENATE(\"KSpread\";\"KOffice\";\"KDE\") returns \"KSpreadKOfficeKDE\""
msgstr ""
"CONCATENATE(\"KSpread\";\"KOffice\";\"KDE\") mengembalikan "
"\"KSpreadKOfficeKDE\""

#. i18n: tag Comment
