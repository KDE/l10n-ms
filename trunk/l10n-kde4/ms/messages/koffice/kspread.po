#. i18n: file functions/financial.xml line 150
#: xml_doc.cpp:2116
msgid "COMPOUND(initial;interest;periods;periods_per_year)"
msgstr "COMPOUND(awal;faedah;tempoh;tempoh_se_tahun)"

