msgid ""
"REGEXPRE(\"14 and 15 and 16\";\"[0-9]+\";\"num\") returns \"num and num and "
"num\""
msgstr ""
"REGEXPRE(\"14 dan 15 dan 16\";\"[0-9]+\";\"num\") mengembalikan \"num and "
"num and num\""

