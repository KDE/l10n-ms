#, fuzzy
#| msgid "DDB(75000;1;60;12;2) returns 1721.81"
msgid "VDB(10000;600;10;0;0.875;1.5) returns 1312.5"
msgstr "DDB(75000;1;60;12;2) mengembalikan 1721.81"

