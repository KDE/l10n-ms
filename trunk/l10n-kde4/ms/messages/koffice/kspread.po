msgid ""
"The BETADIST() function returns the cumulative beta probability density "
"function."
msgstr ""
"Fungsi BETADIST() mengembalikan fungsi ketumpatan kebarangkalian beta "
"kumulatif."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 116
#: xml_doc.cpp:5115
#, fuzzy
#| msgid ""
#| "The last two parameters are optional. They set the lower and upper "
#| "bounds, otherwise defaulting to 0.0 and 1.0 respectively."
