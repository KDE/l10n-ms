"Fungsi CODE() mengembalikan kod angka bagi aksara pertama dalam rentetan "
"teks. "

#. i18n: tag Syntax
#. i18n: file functions/text.xml line 521
#: xml_doc.cpp:7012
msgid "CODE(text)"
msgstr "CODE(teks)"

#. i18n: tag Example
#. i18n: file functions/text.xml line 522
#: xml_doc.cpp:7015
msgid "CODE(\"KDE\") returns 75"
msgstr "CODE(\"KDE\") mengembalikan 75"

#. i18n: tag Text
#. i18n: file functions/text.xml line 535
#: xml_doc.cpp:7021
msgid "Converts text string that represents a value to the real value.  "
msgstr "Menukar rentetan teks yang mewakili nilai bagi nilai sebenar."

#. i18n: tag Syntax
#. i18n: file functions/text.xml line 536
#: xml_doc.cpp:7024
msgid "VALUE(text)"
msgstr "VALUE(teks)"

