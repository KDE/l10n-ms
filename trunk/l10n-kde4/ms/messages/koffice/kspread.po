#. i18n: tag Comment
#. i18n: file functions/financial.xml line 1022
#: xml_doc.cpp:2501 xml_doc.cpp:2666 xml_doc.cpp:2782 xml_doc.cpp:2809
msgid "Type (optional)"
msgstr "Jenis (opsyenal)"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 658
#: xml_doc.cpp:2504
msgid ""
"IPMT calculates the amount of a payment of an annuity going towards interest."
msgstr "IPMT mengira jumlah bayaran anuiti ke arah faedah."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 659
#. i18n: tag Text
#. i18n: file functions/financial.xml line 695
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1027
#: xml_doc.cpp:2507 xml_doc.cpp:2549 xml_doc.cpp:2815
msgid "Rate is the periodic interest rate."
msgstr "Kadar iaah kadar faedah bertempoh."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 660
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1028
#: xml_doc.cpp:2510 xml_doc.cpp:2818
msgid ""
"Period is the amortizement period. 1 for the first and NPER for the last "
"period."
msgstr ""
"Tempoh ialah tempoh pelunasan. 1 untuk yang pertama dan NPER untuk tempoh "
"yang terakhir."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 661
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1029
#: xml_doc.cpp:2513 xml_doc.cpp:2821
msgid "NPER is the total number of periods during which annuity is paid."
msgstr "NPER ialah jumlah bilangan tempoh untuk membayar anuiti."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 662
#. i18n: tag Text
#. i18n: file functions/financial.xml line 698
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1030
#: xml_doc.cpp:2516 xml_doc.cpp:2558 xml_doc.cpp:2824
msgid "PV is the present value in the sequence of payments."
msgstr "PV ialah nilai kini dalam jujukan bayaran."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 663
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1031
#: xml_doc.cpp:2519 xml_doc.cpp:2827
msgid "FV (optional) is the desired (future) value.  default: 0."
msgstr "FV (opsyenal) ialah nilai yang diingini (masa depan).  piawai: 0."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 664
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1032
#: xml_doc.cpp:2522 xml_doc.cpp:2830
msgid ""
"Type (optional) defines the due date. 1 for payment at the beginning of a "
"period and 0 (default) for payment at the end of a period."
msgstr ""
"Jenis (opsyenal) menentukan tarikh cukup tempoh. 1 untuk bayaran pada awal "
"tempoh dan 0 (piawai) untuk bayaran pada akhir tempoh."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 665
#: xml_doc.cpp:2525
msgid ""
"The example shows the interest to pay in the last year of a three year loan. "
"The interest rate is 10 percent."
msgstr ""
"Contoh menunjukkan faedah yang perlu dibayar dalam tahun terakhir bagi "
"pinjaman tiga tahun. Kadar faedah 10 peratus."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 666
#: xml_doc.cpp:2528
msgid "IPMT(Rate; Period; NPer; PV; FV; Type)"
msgstr "IPMT(Kadar; Tempoh NPer; PV; FV; Jenis)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 667
#: xml_doc.cpp:2531
msgid "IPMT(0.1;3;3;8000) equals -292.45"
msgstr "IPMT(0.1;3;3;8000) sama dengan -292.45"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 690
#: xml_doc.cpp:2543
msgid "Present values (PV)"
msgstr "Nilai kini (PV)"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 694
#: xml_doc.cpp:2546
msgid "Calculates the interest paid on a given period of an investment."
msgstr "Kira faedah yang dibayar bagi tempoh pelaburan yang ditetapkan."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 696
#: xml_doc.cpp:2552
msgid ""
"Period is the amortizement period. 1 for the first and NPer for the last "
"period."
msgstr ""
"Tempoh ialah tempoh pelunasan. 1 untuk yang pertama dan NPer untuk tempoh "
"yang terakhir."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 697
#: xml_doc.cpp:2555
msgid "NPer is the total number of periods during which annuity is paid."
msgstr "NPer ialah jumlah tempoh untuk membayar anuiti."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 699
#: xml_doc.cpp:2561
msgid "ISPMT(Rate; Period; NPer; PV)"
msgstr "ISPMT(Kadar; Tempoh; NPer; PV)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 700
#: xml_doc.cpp:2564
msgid "ISPMT(0.1; 1; 3; 8000000) equals -533333"
msgstr "ISPMT(0.1; 1; 3; 8000000) sama dengan -533333"

#. i18n: tag Comment
