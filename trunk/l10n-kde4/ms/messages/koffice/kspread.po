#. i18n: file functions/text.xml line 545
#. i18n: tag Comment
#. i18n: file functions/text.xml line 574
#: xml_doc.cpp:7030 xml_doc.cpp:7060
msgid "Searched text"
msgstr "Teks yang telah dicari"

