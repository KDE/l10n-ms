msgstr "UPPER(\"HELLO\") mengembalikan \"HELLO\""

#. i18n: tag Text
#. i18n: file functions/text.xml line 488
#: xml_doc.cpp:6982
msgid "The LOWER() function converts a string to lower case."
msgstr "Fungsi LOWER() menukar rentetan kepada huruf kecil."

