#. i18n: file functions/datetime.xml line 594
#: xml_doc.cpp:1065
msgid "ISOWEEKNUM(A1) returns 51 when A1 is \"21st of Dec\"."
msgstr "ISOWEEKNUM(A1) mengembalikan 51 apabila  A1 ialah \"21 Dis\"."

