#. i18n: tag Text
#. i18n: file functions/statistical.xml line 847
#: xml_doc.cpp:5755
msgid "The NORMDIST() function returns the normal cumulative distribution."
msgstr "Fungsi NORMDIST() mengembalikan taburan kumulatif normal. "

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 848
#: xml_doc.cpp:5758
msgid ""
"Number is the value of the distribution based on which the normal "
"distribution is to be calculated."
msgstr ""
"Bilangan adalah nilai taburan yang digunakan sebagai asas untuk mengira "
"taburan normal."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 849
#: xml_doc.cpp:5761
msgid "MV is the linear middle of the distribution."
msgstr "MV ialah tengah linear taburan."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 850
#: xml_doc.cpp:5764
msgid "STD is the standard deviation of the distribution."
msgstr "STD ialah sisihan piawai taburan."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 851
#: xml_doc.cpp:5767
msgid ""
"K = 0 calculates the density function; K = 1 calculates the distribution."
msgstr "K = 0 mengira fungsi ketumpatan; K = 1 mengira taburan."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 852
#: xml_doc.cpp:5770
msgid "NORMDIST(Number;MV;STD;K)"
msgstr "NORMDIST(Nombor;MV;STD;K)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 853
#: xml_doc.cpp:5773
msgid "NORMDIST(0.859;0.6;0.258;0) equals 0.934236"
msgstr "NORMDIST(0.859;0.6;0.258;0) sama dengan 0.934236"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 854
#: xml_doc.cpp:5776
msgid "NORMDIST(0.859;0.6;0.258;1) equals 0.842281"
msgstr "NORMDIST(0.859;0.6;0.258;1) sama dengan 0.842281"

