#: xml_doc.cpp:2061
msgid "ACCRINTM(\"2/28/2001\"; \"8/31/2001\"; 0.1; 100) returns 5.0278"
msgstr "ACCRINTM(\"2/28/2001\"; \"8/31/2001\"; 0.1; 100) mengembalikan 5.0278"

