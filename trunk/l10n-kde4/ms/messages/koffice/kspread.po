msgstr "CLEAN(AsciiToChar(7) + \"HELLO\") mengembalikan \"HELLO\""

#. i18n: tag Text
#. i18n: file functions/text.xml line 456
#: xml_doc.cpp:6955
msgid "The SLEEK() function removes all spaces from the string."
msgstr "Fungsi SLEEK() mengalih keluar semua ruang dari rentetan."

#. i18n: tag Syntax
#. i18n: file functions/text.xml line 457
#: xml_doc.cpp:6958
msgid "SLEEK(text)"
msgstr "SLEEK(teks)"

#. i18n: tag Example
#. i18n: file functions/text.xml line 458
#: xml_doc.cpp:6961
