#: scrnsave.cpp:163
msgid "Start a&utomatically"
msgstr "M&ula automatik"

#: scrnsave.cpp:166
msgid "Automatically start the screen saver after a period of inactivity."
msgstr "Mulakan gantian skrin secara automatik selepas satu tempoh tak aktif."

