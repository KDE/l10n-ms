#: solid-powermanagement.cpp:49
msgid "solid-powermanagement"
msgstr "solid-powermanagement"

#: solid-powermanagement.cpp:51
msgid ""
"KDE tool for querying and controlling your power management options from the "
"command line"
msgstr ""
"Alatan KDE untuk menyoal dan mengawal pilihan pengurusan kuasa anda dari "
"arahan baris"

#: solid-powermanagement.cpp:163
msgid "Syntax Error: Not enough arguments"
msgstr "Ralat Sintaks: Tidak cukup hujah"

#: solid-powermanagement.cpp:169
msgid "Syntax Error: Too many arguments"
msgstr "Ralat Sintaks: Terlalu banyak hujah"

#: solid-powermanagement.cpp:181
msgid "Show available commands"
msgstr "Papar arahan yang ada"

#: solid-powermanagement.cpp:183
msgid "Command (see --commands)"
msgstr "Arahan (lihat --commands)"

#: solid-powermanagement.cpp:185
msgid "Arguments for command"
msgstr "Hujah untuk arahan"

#: solid-powermanagement.cpp:197
msgid "Syntax:"
msgstr "Sintaks:"

#: solid-powermanagement.cpp:200
#, fuzzy
#| msgid ""
#| "             # List a particular set of information regarding power "
#| "management.\n"
#| "             # - If the 'suspend' option is specified, give the list of "
#| "suspend\n"
#| "             # methods supported by the system\n"
#| "             # - If the 'scheme' option is specified, give the list of\n"
#| "             # power management schemes supported by this system\n"
#| "             # - If the 'cpufreq' option is specified, give the list of\n"
#| "             # supported CPU frequency policies\n"
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # methods supported by the system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policies\n"
msgstr ""
"             # Senaraikan set tertentu bagi maklumat mengenai kawalan "
"kuasa.\n"
"             # - Jika pilihan 'suspend' dinyatakan, berikan senarai kaedah\n"
"             # gantungan yang disokong oleh sistem\n"
"             # - Jika pilihan 'scheme' dinyatakan, berikan senarai skema\n"
"             # kawalan kuasa yang disokong oleh sistem ini\n"
"             # - Jika pilihan 'cpufreq' dinyatakan, berikan senarai polisi\n"
"             # frekuensi CPU yang disokong\n"

#: solid-powermanagement.cpp:207
#, fuzzy
#| msgid ""
#| "             # Set power management options of the system.\n"
#| "             # - If the 'scheme' option is specified, the power "
#| "management\n"
#| "             # scheme set corresponds to 'value'\n"
#| "             # - If the 'cpufreq' option is specified, the CPU frequency "
#| "policy\n"
#| "             # set corresponds to 'value'\n"
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Tetapkan pilihan pengurusan kuasa bagi sistem.\n"
"             # - Jika pilihan 'scheme' dinyatakan, set skema pengurusan "
"kuasa\n"
"             # bersamaan dengan 'value'\n"
"             # - Jika pilihan 'cpufreq' dinyatakan, set polisi frekuensi "
"CPU\n"
"             # bersamaan dengan 'value'\n"

#: solid-powermanagement.cpp:212
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Gantung komputer menggunakan 'method' diberikan.\n"

#: solid-powermanagement.cpp:215
msgid ""
"             # Set and get brightness options of the system.\n"
"             # - If the 'set' option is specified, the brightness is\n"
"             # set to 'value' (as a percentage)\n"
"             # - If the 'get' option is specified, the current brightness\n"
"             # is returned (as a percentage)'\n"
msgstr ""
"             # Tetap dan dapatkan pilihan kecerahan bagi sistem.\n"
"             # - Jika pilihan 'set' dinyatakan, kecerahan\n"
"             # ditetapkan kepada 'value' (sebagai peratusan)\n"
"             # - Jika pilihan 'get' dinyatakan, kecerahan semasa\n"
"             # dikembalikan (sebagai peratusan)'\n"

