#~ "\"' dalam ~/.bashrc anda, maka\n"
#~ "Konsol boleh tanda bukukan ia, dan pengurusan sesi akan ingat direktori "
#~ "kerja semasa anda\n"
#~ "dalam sistem bukan Linux juga?\n"

