msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Fail audio ini tidak disimpan\n"
"dalam hos tempatan.\n"
"Klik pada label ini untuk memuatkannya.\n"

