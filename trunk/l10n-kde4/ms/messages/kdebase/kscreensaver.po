#: random.cpp:224
msgid "Use OpenGL screen savers"
msgstr "Guna penghias skrin OpenGL"

#: random.cpp:227
msgid "Use screen savers that manipulate the screen"
msgstr "Guna penghias skrin yang memanipulasikan skrin"

