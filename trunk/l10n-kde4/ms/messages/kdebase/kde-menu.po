#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "Item menu '%1' tidak dapat disorotkan."

#: kde-menu.cpp:106
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"Alatan pertanyaan Menu KDE.\n"
"Alat ini boleh digunakan untuk mencari dalam menu yang memaparkan aplikasi "
"khusus.\n"
"Pilihan --highlight boleh digunakan untuk menunjukkan secara visual kepada "
"pengguna\n"
"di mana aplikasi khusus berada dalam menu KDE."

#: kde-menu.cpp:111
msgid "kde-menu"
msgstr "kde-menu"

