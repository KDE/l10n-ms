#: main.cpp:41
msgid "An application to create/update or remove Windows Start Menu entries"
msgstr ""
"Aplikasi untuk mencipta/mengemaskini atau membuang masukan Menu Permulaan "
"Windows"

#: main.cpp:43
#| msgid "(C) 2008 Ralf Habacker"
msgid "(C) 2008-2010 Ralf Habacker"
msgstr "(C) 2008-2010 Ralf Habacker"

#: main.cpp:47
msgid "Remove installed Start Menu entries"
msgstr "Buang masukan Menu Permulaan yang dipasang"

#: main.cpp:48
msgid ""
"Install Start Menu entries (this is also the default when this option is not "
"used)"
msgstr ""
"Pasang masukan Menu Mula (ini juga adalah default apabila pilihan ini tidak "
"digunakan)"

#: main.cpp:49
msgid "query root path of Start Menu entries"
msgstr "tanya laluan asas bagi masukan Menu Permulaan"

#: main.cpp:50
#| msgid "query root path of Start Menu entries"
msgid "don't use categories for start menu entries"
msgstr "jangan guna kategori untuk senarai menu mula"

