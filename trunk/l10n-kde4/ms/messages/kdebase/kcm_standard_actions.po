#: standard_actions_module.cpp:134
msgid "Standard Actions successfully saved"
msgstr "Tindakan Standard berjaya disimpan"

#: standard_actions_module.cpp:136
msgid ""
"The changes have been saved. Please consider:<ul><li>Applications need to be "
"restarted to see the changes.</li>    <li>This change could introduce "
"shortcut conflicts in some applications.</li></ul>"
msgstr ""
"Perubahan telah disimpan. Sila pertimbangkan:<ul><li>Aplikasi perlu untuk "
"diulangmula untuk melihat perubahan.</li>    <li>Perubahan ini mungkin "
"mewujudkan konflik pintasan dalam beberapa aplikasi.</li></ul>"
