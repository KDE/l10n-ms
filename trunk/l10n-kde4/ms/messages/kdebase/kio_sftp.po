#: kio_sftp.cpp:200 kio_sftp.cpp:204 kio_sftp.cpp:668
msgid "SFTP Login"
msgstr "Log masuk SFTP"

#: kio_sftp.cpp:216
msgid "Use the username input field to answer this question."
msgstr "Guna medan masukan nama pengguna untuk menjawab soalan ini."

#: kio_sftp.cpp:405
msgid "Could not allocate callbacks"
msgstr "Tidak dapat memperuntukkan callback"

#: kio_sftp.cpp:468
#, kde-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "Membuka sambungan SFTP ke hos %1:%2"

#: kio_sftp.cpp:472
msgid "No hostname specified."
msgstr "Tiada namahos dinyatakan."

#: kio_sftp.cpp:502
msgid "Could not create a new SSH session."
msgstr "Tidak dapat mulakan sesi baru SSH."

#: kio_sftp.cpp:511 kio_sftp.cpp:516
msgid "Could not set a timeout."
msgstr "Tidak dapat menetapkan masatamat."

#: kio_sftp.cpp:523 kio_sftp.cpp:529
msgid "Could not set compression."
msgstr "Tidak dapat menetapkan mampatan."

#: kio_sftp.cpp:536
msgid "Could not set host."
msgstr "Tidak dapat menetapkan hos."

#: kio_sftp.cpp:543
msgid "Could not set port."
msgstr "Tidak dapat menetapkan port."

#: kio_sftp.cpp:552
msgid "Could not set username."
msgstr ""

#: kio_sftp.cpp:561
msgid "Could not set log verbosity."
msgstr ""

#: kio_sftp.cpp:569
msgid "Could not parse the config file."
msgstr ""

#: kio_sftp.cpp:604
#, kde-format
msgid ""
"The host key for this server was not found, but another type of key exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%1"
msgstr ""

#: kio_sftp.cpp:615
#, kde-format
msgid ""
"The host key for the server %1 has changed.\n"
"This could either mean that DNS SPOOFING is happening or the IP address for "
"the host and its host key have changed at the same time.\n"
"The fingerprint for the key sent by the remote host is:\n"
" %2\n"
"Please contact your system administrator.\n"
"%3"
msgstr ""

#: kio_sftp.cpp:628
msgid "Warning: Cannot verify host's identity."
msgstr "Amaran: Tidak dapat mengenalpasti identiti hos."

#: kio_sftp.cpp:629
#, kde-format
msgid ""
"The authenticity of host %1 cannot be established.\n"
"The key fingerprint is: %2\n"
"Are you sure you want to continue connecting?"
msgstr ""

#: kio_sftp.cpp:660 kio_sftp.cpp:680 kio_sftp.cpp:694 kio_sftp.cpp:736
msgid "Authentication failed."
msgstr "Autentikasi gagal."

#: kio_sftp.cpp:669
msgid "Please enter your username and password."
msgstr "Sila masukkan nama pengguna anda dan kata laluan."

#: kio_sftp.cpp:671
msgid "site:"
msgstr "tapak:"

#: kio_sftp.cpp:711
msgid "Incorrect username or password"
msgstr "Nama pengguna atau kata laluan salah"

#: kio_sftp.cpp:749
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"Tidak dapat meminta untuk subsistem SFTP. Pastikan SFTP dihidupkan pada "
"pelayan"

#: kio_sftp.cpp:757
msgid "Could not initialize the SFTP session."
msgstr "Tidak dapat memulakan sesi SFTP."

#: kio_sftp.cpp:762
#, kde-format
msgid "Successfully connected to %1"
msgstr "Berjaya sambung ke %1"

#: kio_sftp.cpp:1283
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"Tidak dapat mengubah keizinan untuk\n"
"%1"

#: kio_sftp.cpp:1456
#, fuzzy, kde-format
#| msgid "Could not read SFTP packet"
msgid "Could not read link: %1"
msgstr "Tidak dapat membaca paket SFTP"
