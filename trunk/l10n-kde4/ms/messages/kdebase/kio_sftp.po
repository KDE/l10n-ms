#: kio_sftp.cpp:428
msgid "An internal error occurred. Please retry the request again."
msgstr "Ralat dalaman berlaku. Sila cuba lagi."

#: kio_sftp.cpp:511
#, kde-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "Membuka sambungan SFTP ke hos %1:%2"

#: kio_sftp.cpp:515
msgid "No hostname specified"
msgstr "Tiada nama hos ditentukan"

#: kio_sftp.cpp:527
msgid "SFTP Login"
msgstr "Log masuk SFTP"

#: kio_sftp.cpp:529
msgid "site:"
msgstr "tapak:"

#: kio_sftp.cpp:633
msgid "Please enter your username and key passphrase."
msgstr "Sila masukkan nama pengguna anda dan kunci frasa laluan."

#: kio_sftp.cpp:635
msgid "Please enter your username and password."
msgstr "Sila masukkan nama pengguna anda dan kata laluan."

#: kio_sftp.cpp:643
msgid "Incorrect username or password"
msgstr "Nama pengguna atau kata laluan salah"

#: kio_sftp.cpp:648
msgid "Please enter a username and password"
msgstr "Sila masukkan nama pengguna atau kata laluan"

#: kio_sftp.cpp:709
msgid "Warning: Cannot verify host's identity."
msgstr "Amaran: Tidak dapat mengenalpasti identiti hos."

#: kio_sftp.cpp:720
msgid "Warning: Host's identity changed."
msgstr "Amaran: Identiti hos berubah."

#: kio_sftp.cpp:731 kio_sftp.cpp:732
msgid "Authentication failed."
msgstr "Autentikasi gagal."

#: kio_sftp.cpp:746 kio_sftp.cpp:761
msgid "Connection failed."
msgstr "Sambungan gagal."

#: kio_sftp.cpp:747 ksshprocess.cpp:868 ksshprocess.cpp:1015
msgid "Connection closed by remote host."
msgstr "Sambungan ditutup oleh hos jauh."

#: kio_sftp.cpp:762
#, kde-format
msgid "Unexpected SFTP error: %1"
msgstr "Ralat SFTP tidak dijangka: %1"

#: kio_sftp.cpp:806
#, kde-format
msgid "SFTP version %1"
msgstr "SFTP versi %1"

#: kio_sftp.cpp:812
msgid "Protocol error."
msgstr "Ralat protokol."

#: kio_sftp.cpp:818
#, kde-format
msgid "Successfully connected to %1"
msgstr "Berjaya sambung ke %1"

#: kio_sftp.cpp:1178
msgid "An internal error occurred. Please try again."
msgstr "Ralat dalaman berlaku. Sila cuba lagi."

#: kio_sftp.cpp:1199
#, kde-format
msgid ""
"Unknown error was encountered while copying the file to '%1'. Please try "
"again."
msgstr ""
"Ralat tidak diketahui ditemui semasa menyalin fail ke '%1'. Sila cuba lagi."

#: kio_sftp.cpp:1436
msgid "The remote host does not support renaming files."
msgstr "Hos jauh tidak menyokong penamaan semula fail."

#: kio_sftp.cpp:1485
msgid "The remote host does not support creating symbolic links."
msgstr "Hos jauh tidak menyokong pembuatan pautan simbolik."

#: kio_sftp.cpp:1620
msgid "Connection closed"
msgstr "Sambungan ditutup"

#: kio_sftp.cpp:1622
msgid "Could not read SFTP packet"
msgstr "Tidak dapat membaca paket SFTP"

#: kio_sftp.cpp:1735
msgid "End of file."
msgstr "Tamat fail."

#: kio_sftp.cpp:1738
msgid "File does not exist."
msgstr "Fail tidak wujud."

#: kio_sftp.cpp:1742
msgid "Access is denied."
msgstr "Akses dinafikan."

#: kio_sftp.cpp:1746
msgid "SFTP command failed for an unknown reason."
msgstr "Arahan SFT P gagal, punca tidak diketahui."

#: kio_sftp.cpp:1750
msgid "The SFTP server received a bad message."
msgstr "Pelayan SFTP menerima mesej buruk."

#: kio_sftp.cpp:1754
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "Anda meminta operasi yang tidak disokong oleh pelayan SFTP."

#: kio_sftp.cpp:1758
#, kde-format
msgid "Error code: %1"
msgstr "Kod ralat: %1"

#: ksshprocess.cpp:460
msgid "Cannot specify a subsystem and command at the same time."
msgstr "Tidak dapat menentukan subsistem dan arahan pada masa yang sama."

#: ksshprocess.cpp:801
msgid "No options provided for ssh execution."
msgstr "Tiada pilihan disediakan untuk pelaksanaan ssh."

#: ksshprocess.cpp:809
msgid "Failed to execute ssh process."
msgstr "Gagal melaksanakan proses ssh"

#: ksshprocess.cpp:834 ksshprocess.cpp:863 ksshprocess.cpp:982
#: ksshprocess.cpp:1054
msgid "Error encountered while talking to ssh."
msgstr "Ralat ditemui semasa berkomunikasi ke ssh"

#: ksshprocess.cpp:914
msgid "Please supply a password."
msgstr "Masukkan kata laluan."

#: ksshprocess.cpp:953
msgid "Please supply the passphrase for your SSH private key."
msgstr "Masukkan frasa laluan untuk kunci peribadi SSH anda."

#: ksshprocess.cpp:967
#, kde-format
msgid "Authentication to %1 failed"
msgstr "Pengesahan ke %1 gagal"

#: ksshprocess.cpp:990
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified because the "
"host's key is not in the \"known hosts\" file."
msgstr ""
"Identiti hos jauh '%1' tidak dapat ditentukan kerana kunci hos tiada di "
"dalam fail \"hos diketahui\"."

#: ksshprocess.cpp:996
msgid ""
" Manually, add the host's key to the \"known hosts\" file or contact your "
"administrator."
msgstr ""
" Secara manual, masukkan kunci hos di dalam  fail \"hos diketahui\" atau "
"hubungi pentadbir anda."

#: ksshprocess.cpp:1002
#, kde-format
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr " Secara manual, masukkan kunci hos ke %1 atau hubungi pentadbir anda."

#: ksshprocess.cpp:1034
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key "
"fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before "
"connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""
"Identiti hos jauh '%1' tidak dapat disahkan. Cap jari kekunci hos ialah:\n"
"%2\n"
"Anda perlu mengesahkan cap jari dengan pentadbir hos sebelum menyambung.\n"
"\n"
"Adakah anda hendak menerima kekunci hos dan teruskan sambungan? "

#: ksshprocess.cpp:1062
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""
"AMARAN: Identiti hos jauh %1 telah berubah!\n"
"\n"
"Seseorang mungkin mencuri dengar sambungan anda, atau pentadbir mungkin "
"telah mengubah kekunci hos. Oleh itu, anda perlu mengesahkan kekunci cap "
"jari hos dengan pentadbir hos. Kekunci cap jari ialah:\n"
"%2\n"
"Tambah kekunci hos yang betul \"%3\" untuk menghilangkan mesej ini."

#: ksshprocess.cpp:1097
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""
"AMARAN: Identiti hos jauh %1 telah berubah!\n"
"\n"
"Seseorang mungkin mencuri dengar sambungan anda, atau pentadbir mungkin "
"telah mengubah kekunci hos. Oleh itu, anda perlu mengesahkan kekunci cap "
"jari hos dengan pentadbir hos. Kekunci cap jari ialah:\n"
"%2\n"
"\n"
"Adakah anda hendak menerima kekunci hos baru dan teruskan sambungan?"

#: ksshprocess.cpp:1121
msgid "Host key was rejected."
msgstr "Kunci hos telah ditolak."
