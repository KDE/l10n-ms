#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 156
#: rc.cpp:192
#, no-c-format
msgid "Enable icon mouse over effects"
msgstr "Hidupkan kesan mouse over ikon"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 161
#: rc.cpp:196
#, no-c-format
msgid "Show icons in mouse over effects"
msgstr "Papar ikon dalam kesan mouse over"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 166
#: rc.cpp:200
#, no-c-format
msgid "Show text in mouse over effects"
msgstr "Papar teks da dalam kesan mouse over"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 171
#: rc.cpp:204
#, no-c-format
msgid ""
"Controls how fast the tooltips fade in, measured in thousandths of a second"
msgstr ""
"Mengawal berapa cepat tip alat menjadi pudar, diukur dalam per seribu saat"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 177
#: rc.cpp:208
#, no-c-format
msgid "Mouse over effects are shown after the defined time (in milliseconds)"
msgstr ""
"Kesan tetikus-di atas ditayangkan selepas masa yang ditetapkan (dalam "
"milisaat)"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 182
#: rc.cpp:212
#, no-c-format
msgid "Mouse over effects are hidden after the defined time (in milliseconds)"
msgstr ""
"Kesan tetikus-di atas disembunyikan selepas masa yang ditetapkan (dalam "
"milisaat)"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 187
#: rc.cpp:216
#, no-c-format
msgid "The margin between panel icons and the panel border"
msgstr "Jidar di antara ikon panel dengan sempadan panel"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 192
#: rc.cpp:220
#, no-c-format
msgid ""
"Buttons that represent KServices (applications, primarily) watch for the "
"removal of the service and delete themselves when this happens. This setting "
"turns this off."
msgstr ""
"Butang yang mewakili KServices (aplikasi, primer) memerhatikan pembuangkan "
"servis dan butang ini hapus sendiri apabila ini berlaku. Seting ini menutup "
"semua ini."

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 197
#: rc.cpp:224
#, no-c-format
msgid "Font for the buttons with text."
msgstr "Font pada butang dengan teks."

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 202
#: rc.cpp:228
#, no-c-format
msgid "Text color for the buttons."
msgstr "Warna teks untuk butang."

