#: main.cpp:49
msgid "Run Plasma widgets in their own window"
msgstr "Laksana aplet Plasma dalam tetingkap mereka sendiri"

#: main.cpp:100
msgid "No description available"
msgstr "Tidak keterangan didapati"

#: main.cpp:117
msgid "Plasma Widget Viewer"
msgstr "Pelihat Aplet Plasma"

#: main.cpp:119
msgid "2007-2008, Frerich Raabe"
msgstr "2007-2008, Frerich Raabe"

#: main.cpp:121
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:122
msgid "Original author"
msgstr "Pengarang asal"

#: main.cpp:129
msgid "Name of the containment plugin"
msgstr "Nama bagi plugin terkawal"

#: main.cpp:131
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr ""
"Formfactor untuk digunakan (horizontal, vertical, mediacenter atau planar)"

#: main.cpp:132
msgid "Displays a list of known applets"
msgstr "Papar senarai aplet yang diketahui"

#: main.cpp:133
msgid "Displays a list of known wallpapers"
msgstr "Papar senarai kertas dinding yang diketahui"

#: main.cpp:134
msgid "Displays a list of known containments"
msgstr "Papar senarai kandungan yang diketahui"

#: main.cpp:136
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"Lokasi kekangan untuk memulakan Penghadang dengan (floating, desktop, "
"fullscreen, top, bottom, left, right)"

#: main.cpp:138
#, fuzzy
#| msgid "The size in KB to set the pixmap cache to"
msgid "The size in kB to set the pixmap cache to"
msgstr "Saiz dalam KB untuk menetapkan cache pixmap kepadanya"

#: main.cpp:140
msgid ""
"Takes a screenshot of the widget and saves it the working directory as "
"<pluginname>.png"
msgstr ""
"Mengambil cekupan skrin bagi widget dan menyimpannya didalam direktori kerja "
"sebagai <pluginname>.png"

#: main.cpp:141
msgid ""
"Takes a screenshot of each widget and saves it the working directory as "
"<pluginname>.png"
msgstr ""
"Mengambil cekupan skrin bagi setiap widget dan menyimpannya didalam "
"direktori kerja sebagai <pluginname>.png"

#: main.cpp:143
msgid "Desktop SVG theme to use"
msgstr "Tema SVG desktop untuk digunakan"

#: main.cpp:145
msgid ""
"Name of the wallpaper plugin. Requires a containment plugin to be specified."
msgstr ""
"Nama bagi plugin kertas dinding. Memerlukan plugin containment perlu "
"dinyatakan."

#: main.cpp:146
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"Nama aplet untuk dilihat; boleh merujuk kepada nama plugin atau laluan "
"(nyata atau relatif) kepada pakej. Jika tidak diberikan, maka percubaan akan "
"dibuat untuk memuatkan pakej dari direktori semasa."

#: main.cpp:149
msgid "Optional arguments of the applet to add"
msgstr "Hujah pilihan tambahan bagi aplet untuk ditambah"

#: main.cpp:150
msgid "List zeroconf announced remote widgets"
msgstr "Senarai widget jauh yang diumumkan zeroconf"

