#: kwriteconfig.cpp:24
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"Jenis pembolehubah. Guna \"bool\" untuk  boolean, jika tidak cara "
"pengendalian akan menggunakan rentetan (string)"

