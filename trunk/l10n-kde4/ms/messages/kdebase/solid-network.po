" ustatus ialah\n"
" ialah dibolehkan for\n"
" ialah\n"
" ialah dibolehkan for\n"
" ialah\n"
" ialah dibolehkan\n"
" ialah\n"
" bagi hingga\n"
" ialah\n"
" bagi buka hingga n"

