#: kio_trash.cpp:112
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Direktori %1 tidak lagi wujud, jadi tidak mungkin untuk mengembalikan item "
"ini ke lokasi asal. Anda boleh sama ada mencipta semula direktori tersebut "
"atau guna operasi pengembalian semula, atau seret item ke tempat lain untuk "
"mengembalikannya."

