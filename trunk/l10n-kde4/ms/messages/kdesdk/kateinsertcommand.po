#~ msgstr "Gagal Matikan"

#~ msgid ""
#~ "Executing command:\n"
#~ "%1\n"
#~ "\n"
#~ "Press 'Cancel' to abort."
#~ msgstr ""
#~ "Arahan Laku:\n"
#~ "%1\n"
#~ "\n"
#~ "Tekan 'Batal' untuk henti paksa."

#~ msgid "Command exited with status %1"
