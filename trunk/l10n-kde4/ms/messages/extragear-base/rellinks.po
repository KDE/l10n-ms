#: plugin_rellinks.cpp:57
msgid "Rellinks"
msgstr ""

#: plugin_rellinks.cpp:72
msgid "&Top"
msgstr "&Atas"

#: plugin_rellinks.cpp:75
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr ""
"<p>Ini memautkan rujukan dengan laman utama atau bahagian atas sesetangah "
"hierarki.</p>"

#: plugin_rellinks.cpp:80
msgid "&Up"
msgstr "&Ke atas"

#: plugin_rellinks.cpp:83
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr ""
"<p>Ini memautkan rujukan dengan induk terdekat bagi dokumen semasa.</p>"

#: plugin_rellinks.cpp:90
msgid "&First"
msgstr "&Pertama"

#: plugin_rellinks.cpp:93
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>Jenis pautan ini memberitahu enjin cari dokumen mana dianggap oleh "
"pengarang menjadi titik mula koleksi.</p>"

#: plugin_rellinks.cpp:98
msgid "&Previous"
msgstr ""

#: plugin_rellinks.cpp:102
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr ""
"<p>Pautan ini merujuk dokumen sebelumnya menurut siri dokumen bertertib.</p>"

#: plugin_rellinks.cpp:106
msgid "&Next"
msgstr ""

#: plugin_rellinks.cpp:109
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr ""
"<p>Pautan ini merujuk dokumen berikutnya menurut siri dokumen bertertib.</p>"

#: plugin_rellinks.cpp:114
msgid "&Last"
msgstr "&Terakhir"

#: plugin_rellinks.cpp:118
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>Pautan ini merujuk penghujung jujukan dokumen.</p>"

#: plugin_rellinks.cpp:123
msgid "&Search"
msgstr "&Cari"

#: plugin_rellinks.cpp:126
msgid "<p>This link references the search.</p>"
msgstr "<p>Pautan ini merujuk carian.</p>"

#: plugin_rellinks.cpp:131
msgid "Document"
msgstr "Dokumen"

#: plugin_rellinks.cpp:133
msgid "<p>This menu contains the links referring the document information.</p>"
msgstr "<p>Menu ini mengandungi pautan yang merujuk maklumat dokumen.</p>"

#: plugin_rellinks.cpp:137
msgid "Table of &Contents"
msgstr "Jadual &Kandungan"

#: plugin_rellinks.cpp:139
msgid "<p>This link references the table of contents.</p>"
msgstr "<p>Pautan ini merujuk jadual kandungan.</p>"

#: plugin_rellinks.cpp:144
msgid "Chapters"
msgstr "Bab"

#: plugin_rellinks.cpp:149
msgid "<p>This menu references the chapters of the document.</p>"
msgstr "<p>Menu ini merujuk bab dalam dokumen.</p>"

#: plugin_rellinks.cpp:152
msgid "Sections"
msgstr "Bahagian"

#: plugin_rellinks.cpp:158
msgid "<p>This menu references the sections of the document.</p>"
msgstr "<p>Menu ini merujuk bahagian dokumen.</p>"

#: plugin_rellinks.cpp:161
msgid "Subsections"
msgstr "Subbahagian"

#: plugin_rellinks.cpp:166
msgid "<p>This menu references the subsections of the document.</p>"
msgstr "<p>Menu ini merujuk subbahagian dokumen.</p>"

#: plugin_rellinks.cpp:169
msgid "Appendix"
msgstr "Lampiran"

#: plugin_rellinks.cpp:174
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Pautan ini merujuk lampiran.</p>"

#: plugin_rellinks.cpp:178
msgid "&Glossary"
msgstr "&Glosari"

#: plugin_rellinks.cpp:181
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Pautan ini merujuk glosari.</p>"

#: plugin_rellinks.cpp:186
msgid "&Index"
msgstr "&Indeks"

#: plugin_rellinks.cpp:188
msgid "<p>This link references the index.</p>"
msgstr "<p>Pautan ini merujuk indeks.</p>"

#: plugin_rellinks.cpp:194
msgid "More"
msgstr "Lagi"

#: plugin_rellinks.cpp:196
msgid "<p>This menu contains other important links.</p>"
msgstr "<p>Menu ini mengandungi pautan penting lain.</p>"

#: plugin_rellinks.cpp:200
msgid "&Help"
msgstr ""

#: plugin_rellinks.cpp:203
msgid "<p>This link references the help.</p>"
msgstr "<p>Pautan ini merujuk bantuan.</p>"

#: plugin_rellinks.cpp:209
msgid "&Authors"
msgstr "&Pengarang"

#: plugin_rellinks.cpp:212
msgid "<p>This link references the author.</p>"
msgstr "<p>Pautan ini merujuk pengarang.</p>"

#: plugin_rellinks.cpp:218
msgid "Copy&right"
msgstr "&Hak Cipta"

#: plugin_rellinks.cpp:221
msgid "<p>This link references the copyright.</p>"
msgstr "<p>Pautan ini merujuk hak cipta.</p>"

#: plugin_rellinks.cpp:226
msgid "Bookmarks"
msgstr ""

#: plugin_rellinks.cpp:229
msgid "<p>This menu references the bookmarks.</p>"
msgstr "<p>Menu ini merujuk tanda buku.</p>"

#: plugin_rellinks.cpp:233
msgid "Other Versions"
msgstr "Versi Lain"

#: plugin_rellinks.cpp:236
msgid "<p>This link references the alternate versions of this document.</p>"
msgstr "<p>Pautan ini merujuk versi silih ganti dokumen ini.</p>"

#: plugin_rellinks.cpp:241
#, fuzzy
msgid "Miscellaneous"
msgstr "<p>Pautan pelbagai.</p>"

#: plugin_rellinks.cpp:244
msgid "<p>Miscellaneous links.</p>"
msgstr "<p>Pautan pelbagai.</p>"

