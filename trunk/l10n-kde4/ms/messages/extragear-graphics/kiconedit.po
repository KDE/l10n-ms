#: kiconedit.cpp:440
#, kde-format
msgid "Ellipse"
msgstr "Bujur"

#: kiconedit.cpp:444
#, kde-format
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"Bujur\n"
"\n"
"Lukis bujur"

#: kiconedit.cpp:448
#, kde-format
msgid "Filled Ellipse"
msgstr "Bujur Berwarna"

#: kiconedit.cpp:452
#, kde-format
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"Bujur berwarna\n"
"\n"
"Lukis bujur berwarna"

#: kiconedit.cpp:456
#, kde-format
msgid "Spray"
msgstr "Sembur"

#: kiconedit.cpp:460
#, kde-format
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"Semburan\n"
"\n"
"Lukis piksel berselerak dalam warna semasa"

#: kiconedit.cpp:465
#, kde-format
msgid "Flood Fill"
msgstr "Warna Banjir"

#: kiconedit.cpp:469
#, kde-format
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"Warna banjir\n"
"\n"
"Warnakan piksel bersebelahan dengan warna yang sama dengan warna semasa"

#: kiconedit.cpp:474
#, kde-format
msgid "Line"
msgstr "Garisan"

#: kiconedit.cpp:478
#, kde-format
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"Garisan\n"
"\n"
"Lukis garisan lurus menegak, mendatar atau pada sudut 45 darjah"

#: kiconedit.cpp:483
#, kde-format
msgid "Eraser (Transparent)"
msgstr "Pemadam (Lutsinar)"

#: kiconedit.cpp:487
#, kde-format
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"Padam\n"
"\n"
"Padam piksel. Setkan piksel menjadi lutsinar\n"
"\n"
"(Tip: Jika anda ingin melukis lutsinar dengan menggunakan alat berlainan, "
"mula-mula klik \"Padam\" kemudian klik alat yang anda ingin guna)"

#: kiconedit.cpp:494
#, kde-format
msgid "Rectangular Selection"
msgstr "Pilihan Segi Empat Tepat"

#: kiconedit.cpp:498
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"Pilih\n"
"\n"
"Pilih bahagian segi empat tepat ikon menggunakan tetikus."

#: kiconedit.cpp:503
#, kde-format
msgid "Circular Selection"
msgstr "Pilihan Bulatan"

#: kiconedit.cpp:507
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""
"Pilih\n"
"\n"
"Pilih bahagian bulatan ikon menggunakan tetikus."

#: kiconedit.cpp:535
#, kde-format
msgid ""
"Statusbar\n"
"\n"
"The statusbar gives information on the status of the current icon. The "
"fields are:\n"
"\n"
"\t- Application messages\n"
"\t- Cursor position\n"
"\t- Size\n"
"\t- Zoom factor\n"
"\t- Number of colors"
msgstr ""
"Bar status\n"
"\n"
"Bar status memberikan maklumat tentang status ikon semasa. Medannya ialah:\n"
"\n"
"\t- Mesej Aplikasi\n"
"\t- Posisi kursor\n"
"\t- Saiz\n"
"\t- Faktor Zum\n"
"\t- Bilangan warna"

