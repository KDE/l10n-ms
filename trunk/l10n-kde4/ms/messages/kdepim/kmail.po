#. i18n: file smimeconfiguration.ui line 32
#: rc.cpp:951
msgid "Validate certificates online (OCSP)"
msgstr "Sahkan sijil secara dalam talian (PSDT)"

#. i18n: tag string
#. i18n: file smimeconfiguration.ui line 39
#: rc.cpp:954
