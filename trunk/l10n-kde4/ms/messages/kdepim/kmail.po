"%REM=\"Default forward template\"%-\n"
"\n"
"----------  %1  ----------\n"
"\n"
"Subject: %OFULLSUBJECT\n"
"Date: %ODATE\n"
"From: %OFROMADDR\n"
"To: %OTOADDR\n"
"\n"
"%TEXT\n"
"-------------------------------------------------------\n"
msgstr ""

