#. i18n: file signatureconfigurationdialog.ui line 81
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 95
#: rc.cpp:1044 rc.cpp:1056 rc.cpp:1068 rc.cpp:1080
#, no-c-format
msgid "Selects which certificates to send"
msgstr "Pilih sijil yang hendak dihantar"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 53
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 70
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 84
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 98
#: rc.cpp:1048 rc.cpp:1060 rc.cpp:1072 rc.cpp:1084
#, no-c-format
msgid ""
"<qt> <h1>Sending Certificates</h1> Without your certificate, the receiver "
"will not be able to determine whether it was really you who sent the message "
"or whether the message was altered by a third party. <p> The receiver can "
"obtain your certificate from a central server, but you can also opt to "
"enclose your certificate with your message. You can select whether you do "
"not want to include a certificate at all, only your own certificate or the "
"whole chain of certificates that certify your own certificate, including or "
"excluding the root certificate. <p> It is recommended to always include at "
"least your own certificate with the message. <p> This setting is a default, "
"you can override it for each individual message. </qt>"
msgstr ""
"<qt> <h1>Menghantar sijil</h1> Tanpa sijil anda, penerima tidak dapat "
"menentukan sama ada mesej benar-benar dihantar oleh anda atau kemungkinan "
"mesej telah dipinda oleh pihak ketiga. <p> Penerima boleh mendapatkan sijil "
"anda dari pelayan pusat, tapi anda boleh memilih untuk menyertakan sijil "
"bersama mesej. Anda boleh memilih sama ada tidak menyertakan sebarang sijil "
"sama sekali, hanya sijil anda atau seluruh rantaian sijil yang mengesahkan "
"sijil anda, termasuk atau tidak termasuk sijil root. <p> Dicadangkan supaya "
"sentiasa menyertakan sekurang-kurang sijil anda sendiri bersama mesej. <p> "
"Seting ini adalah piawai, anda boleh menulis tindih untuk setiap mesej. </qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 61
#: rc.cpp:1052
#, no-c-format
msgid "Send &your own certificate"
msgstr "Hantar sijil &anda sendiri"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 78
#: rc.cpp:1064
#, no-c-format
msgid "Send certificate chain &without root"
msgstr "Hantar rantaian sijil &tanpa root"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 92
#: rc.cpp:1076
#, no-c-format
msgid "Send certificate c&hain with root"
msgstr "Hantar ra&ntaian sijil bersama root"

