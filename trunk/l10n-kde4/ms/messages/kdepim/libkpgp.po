#: kpgpbase2.cpp:168
#, qt-format
msgid ""
"Public keys not certified with trusted signature for userid(s)\n"
"%1.\n"
"The message is not encrypted."
msgstr ""
"Kekunci umum tidak disahkan dengan tandatangan yang dipercayai untuk id "
