#. i18n: file ./dnssd/kcm_kdnssd.kcfg line 14
#: rc.cpp:26
#, no-c-format
msgid ""
"If true .local domain will be browsed. It is always link-local, using "
"multicast DNS."
msgstr ""
"Jika benar domain .local akan dipaparkan. Ia sentiasa paut-lokal menggunakan "
"DNS multikas"

