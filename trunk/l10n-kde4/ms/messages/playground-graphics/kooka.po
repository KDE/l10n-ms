#: kocrgocr.cpp:133
msgid "&Gray level"
msgstr "Tahap &kelabu"

#: kocrgocr.cpp:137
msgid ""
"The numeric value gray pixels are \n"
"considered to be black.\n"
"\n"
"Default is 160"
msgstr ""
"Nilai angka piksel kelabu \n"
"dianggap hitam.\n"
"\n"
"Piawai ialah 160"

