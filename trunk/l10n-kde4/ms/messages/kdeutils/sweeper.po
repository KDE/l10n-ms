#: rc.cpp:21
msgid "Financial Information"
msgstr "Maklumat Kewangan"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 89
#: rc.cpp:24
msgid ""
"Warn me when I visit a site that uses my financial or purchase information:"
msgstr ""
"Beri amaran sekiranya saya melawat laman yang menggunakan maklumat kewangan "
"atau pembelian saya:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 99
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 135
#: rc.cpp:27 rc.cpp:39
msgid "For marketing or advertising purposes"
msgstr "Untuk tujuan pemasaran atau pengiklanan"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 106
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 142
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 178
#: rc.cpp:30 rc.cpp:42 rc.cpp:54
msgid "To share with other companies"
msgstr "Untuk dikongsi dengan syarikat-syarikat lain"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 116
#: rc.cpp:33
msgid "Health Information"
msgstr "Maklumat Kesihatan"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 125
#: rc.cpp:36
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Beri amaran sekiranya saya melawat laman yang menggunakan maklumat kesihatan "
"atau perubatan saya: "

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:45
msgid "Demographics"
msgstr "Demografik"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:48
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Beri amaran sekiranya saya melawat ke laman yang menggunakan maklumat saya "
"yang tidak dapat kenal pasti."

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:51
msgid "To determine my interests, habits or general behavior"
msgstr "Untuk menentukan minat saya, habit atau perlakuan biasa"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Beri amaran apabila saya melawat laman yang berkongsi maklumat peribadi saya "
"dengan syarikat lain"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:60
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Beri amaran apabila saya melawat tapak yang tidak memberitahu maklumat apa "
"yang mereka ada mengenai saya"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:63
msgid "Personal Information"
msgstr "Maklumat Peribadi"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:66
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Beri amaran sekiranya saya melawat ke laman yang menghubungkan saya tentang "
"produk lain atau servis."

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:69
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Beri amaran sekiranya saya melawat ke laman yang menggunakan maklumat "
"peribadi saya ke:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:72
msgid "Determine my habits, interests or general behavior"
msgstr "Pastikan habit saya, minat atau perlakuan umum"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:75
msgid "Via telephone"
msgstr "Menerusi telefon"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:78
msgid "Via mail"
msgstr "Melalui mel"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:81
msgid "Via email"
msgstr "Melalui emel"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "Dan jangan benarkan saya membuang maklumat perhubungan saya"

