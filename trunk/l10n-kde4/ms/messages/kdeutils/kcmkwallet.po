msgstr "Pengurus Wallet"

#. i18n: tag string
#. i18n: file walletconfigwidget.ui line 268
#: rc.cpp:60
msgid "Show manager in system tray"
msgstr "Papar pengurus dalam dulang sistem"

#. i18n: tag string
#. i18n: file walletconfigwidget.ui line 278
#: rc.cpp:63
msgid "Hide system tray icon when last wallet closes"
msgstr "Sembunyikan ikon dulang sistem apabila wallet terakhir ditutup"

#. i18n: tag string
#. i18n: file walletconfigwidget.ui line 305
#: rc.cpp:66
msgid "Access Control"
msgstr "Kawalan Akses"

#. i18n: tag string
#. i18n: file walletconfigwidget.ui line 314
#: rc.cpp:69
msgid "&Prompt when an application accesses an open wallet"
msgstr "&Gesa apabila aplikasi mengakses wallet yang dibuka"

#. i18n: tag string
