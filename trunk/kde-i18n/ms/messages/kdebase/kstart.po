#: kstart.cpp:193
msgid "Command to execute."
msgstr "Arahan untuk laksanakan"

#: kstart.cpp:195
msgid ""
"A regular expression matching the window title.\n"
"If you do not specify one, then the very first window\n"
"to appear will be taken. NOT RECOMMENDED!"
msgstr ""

#: kstart.cpp:198
msgid "Desktop where to make the window appear. "
msgstr "Ruang kerja di mana tetingkap dipaparkan."

#: kstart.cpp:199
msgid ""
"Make the window appear on the desktop that was active\n"
"when starting the application. "
msgstr ""

#: kstart.cpp:200
msgid "Make the window appear on all desktops"
msgstr "Jadikan tetingkap dipaparkan di semua ruang kerja"

#: kstart.cpp:201
msgid "Iconify the window"
msgstr "Ikonkan tetingkap"

#: kstart.cpp:202
msgid "Maximize the window"
msgstr "Maksimakan tetingkap"

#: kstart.cpp:203
msgid "Show window fullscreen. Implies type Override."
msgstr ""

#: kstart.cpp:204
msgid ""
"The window type: Normal, Desktop, Dock, Tool, \n"
"Menu, Dialog, TopMenu or Override"
msgstr ""

#: kstart.cpp:205
msgid ""
"Jump to the window even if it is started on a \n"
"different virtual desktop"
msgstr ""

#: kstart.cpp:208
msgid "Try to keep the window above other windows"
msgstr "Cuba jadikan tetingkap di atas tetingkap lain"

#: kstart.cpp:210
msgid "Try to keep the window below other windows"
msgstr "Cuba jadikan tetingkap di bawah tetingkap lain"

#: kstart.cpp:211
msgid "The window does not get an entry in the taskbar"
msgstr "Tetingkap tidak mendapat ruang pada papan tugas"

#: kstart.cpp:212
msgid "The window does not get an entry on the pager"
msgstr "Tetingkap tidak mendapat ruang pada laman"

#: kstart.cpp:213
msgid "The window is sent to the system tray in Kicker."
msgstr "Tetingkap dihantar ke dulang sistem di dalam Kicker."

#: kstart.cpp:220
msgid "KStart"
msgstr "KStart"

#: kstart.cpp:221
msgid ""
"Utility to launch applications with special window properties \n"
"such as iconified, maximized, a certain virtual desktop, a special "
"decoration\n"
"and so on."
msgstr "Utiliti untuk melancarkan aplikasi dengan ciri-ciri isitimewa tetingkap \n"
"seperti diikonkan, dimaksimakan, ruang kerja maya, hiasan khas,\n"
"dan lain-lain."

#: kstart.cpp:241
msgid "No command specified"
msgstr "Tiada arahan ditentukan"

