#: imap4.cc:808
msgid "What do you want to store in this folder?"
msgstr "Apa yang anda mahu storkan di folder ini?"

#: imap4.cc:808
msgid "Create Folder"
msgstr "Cipta Folder"

#: imap4.cc:809
msgid "&Messages"
msgstr "&Mesej"

#: imap4.cc:809
msgid "&Subfolders"
msgstr "&Subfolder"

#: imap4.cc:1087
msgid "Unsubscribe of folder %1 failed."
msgstr "Nyah langgan folder %1 gagal."

#: imap4.cc:1104
msgid "Subscribe of folder %1 failed."
msgstr "Langgan folder %1 gagal."

#: imap4.cc:1126 imap4.cc:1137
msgid "Changing the flags of message %1 failed."
msgstr "Perubahan bendera mesej %1 gagal."

#: imap4.cc:1226
msgid "Unable to close mailbox."
msgstr "Gagal menutup kotak mel."

#: imap4.cc:1249
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Gagal mendapatkan maklumat berkaitan folder %1. Pelayan membalas: %2"

#: imap4.cc:1412
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Pelayan %1 tidak menyokong samada IMAP4 atau IMAP4rev1.\n"
"Pengenalan diri sebagai: %2"

#: imap4.cc:1423
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Pelayan tidak menyokong TLS\n"
"Matikan ciri-ciri sekuriti ini untuk sambungan tanpa enkrip."

#: imap4.cc:1448
msgid "Starting TLS failed."
msgstr "Gagal memulakan TLS."

#: imap4.cc:1458
msgid "The authentication method %1 is not supported by the server."
msgstr "Kaedah authentikasi %1 tidak disokong oleh pelayan."

#: imap4.cc:1469
msgid "Username and password for your IMAP account:"
msgstr "Nama pengguna dan kata laluan untuk akaun IMAP."

#: imap4.cc:1483
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or try to get a "
"different username."
msgstr ""
"Dalam log masuk IMAP teks kosong, hanya ada aksara US-ASCII. Gunakan kaedah "
"pengesahan berlainan yang pelayan anda sokong atau cuba gunakan nama "
"pengguna yang lain."

#: imap4.cc:1488
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or change your "
"password."
msgstr ""
"Dalam log masuk IMAP teks kosong, hanya ada aksara US-ASCII. Gunakan kaedah "
"pengesahan berlainan yang pelayan anda sokong atau tukar kata laluan anda."

#: imap4.cc:1493
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Gagal log masuk. Mungkin kata laluan salah.\n"
"Pelayan membalas:\n"
"%1"

#: imap4.cc:1499
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Gagal mengesahkan menerusi %1.\n"
"Pelayan membalas:\n"
"%2"

#: imap4.cc:1895
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Gagal membuka folder %1. Pelayan membalas: %2"
