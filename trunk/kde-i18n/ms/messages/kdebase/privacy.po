#: rc.cpp:23
#, no-c-format
msgid "Financial Information"
msgstr "Maklumat Kewangan"

#: rc.cpp:25
#, no-c-format
msgid "Warn me when I visit a site that uses my financial or purchase information:"
msgstr "Beri amaran sekiranya saya melawat laman yang menggunakan maklumat kewangan atau pembelian saya:"

#: rc.cpp:27
#: rc.cpp:35
#, no-c-format
msgid "For marketing or advertising purposes"
msgstr "Untuk tujuan pemasaran atau pengiklanan"

#: rc.cpp:29
#: rc.cpp:37
#: rc.cpp:45
#, no-c-format
msgid "To share with other companies"
msgstr "Untuk dikongsi dengan syarikat-syarikat lain"

#: rc.cpp:31
#, no-c-format
msgid "Health Information"
msgstr "Maklumat Kesihatan"

#: rc.cpp:33
#, no-c-format
msgid "Warn me when I visit a site that uses my health or medical information: "
msgstr "Beri amaran sekiranya saya melawat laman yang menggunakan maklumat kesihatan atau perubatan saya: "

#: rc.cpp:39
#, no-c-format
msgid "Demographics"
msgstr "Demografik"

#: rc.cpp:41
#, no-c-format
msgid "Warn me when I visit a site that uses my non-personally identifiable information:"
msgstr "Beri amaran sekiranya saya melawat ke laman yang menggunakan maklumat saya yang tidak dapat kenal pasti."

#: rc.cpp:43
#, no-c-format
msgid "To determine my interests, habits or general behavior"
msgstr "Untuk menentukan minat saya, habit atau perlakuan biasa"

#: rc.cpp:47
#, no-c-format
msgid "Warn me when I visit a site that shares my personal information with other companies"
msgstr "Beri amaran apabila saya melawat laman yang berkongsi maklumat peribadi saya dengan syarikat lain"

#: rc.cpp:49
#, fuzzy, no-c-format
msgid "Warn me when I visit a site that does not let me know what information they have about me"
msgstr "Amaran I"

#: rc.cpp:51
#, no-c-format
msgid "Personal Information"
msgstr "Maklumat Peribadi"

#: rc.cpp:53
#, no-c-format
msgid "Warn me when I visit a site that may contact me about other products or services:"
msgstr "Beri amaran sekiranya saya melawat ke laman yang menghubungkan saya tentang produk lain atau servis."

#: rc.cpp:55
#, no-c-format
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr "Beri amaran sekiranya saya melawat ke laman yang menggunakan maklumat peribadi saya ke:"

#: rc.cpp:57
#, no-c-format
msgid "Determine my habits, interests or general behavior"
msgstr "Pastikan habit saya, minat atau perlakuan umum"

#: rc.cpp:59
#, no-c-format
msgid "Via telephone"
msgstr "Menerusi telefon"

#: rc.cpp:61
#, no-c-format
msgid "Via mail"
msgstr "Melalui mel"

#: rc.cpp:63
#, no-c-format
msgid "Via email"
msgstr "Melalui emel"

#: rc.cpp:65
#, no-c-format
msgid "And do not allow me to remove my contact information"
msgstr "Dan jangan benarkan saya membuang maklumat perhubungan saya"

