#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Pengurus sesi KDE yang berinteraksi dengan\n"
"protokol pengurusan sesi X11R6 piawai (XSMP)."

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Pulihkan semula sesi yang disimpan pengguna jika ada"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Mulakan 'wm' jika tiada pengurus tetingkap lain \n"
"yang berada di dalam sesi. Default ialah 'kwin'"

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Benarkan sambungan jauh juga."

#: main.cpp:182
msgid "The KDE Session Manager"
msgstr "Pengurus Sesi KDE"

#: shutdown.cpp:82
msgid "End Session for \"%1\""
msgstr "Tamat Sesi untuk \"%1\""

#: shutdown.cpp:106
msgid "What do you want to do next?"
msgstr "Apa yang anda ingin lakukan kemudian?"

#: shutdown.cpp:107
msgid "&Login as different user"
msgstr "&Log masuk sebagai pengguna lain"

#: shutdown.cpp:108
msgid "&Turn off computer"
msgstr "&Tutup komputer"

#: shutdown.cpp:109
msgid "&Restart computer"
msgstr "Mulakan semula kompute&r"

#: shutdown.cpp:130
msgid "Shutdown Mode"
msgstr "Mod Tutup Semua"

#: shutdown.cpp:131
msgid "Sch&edule"
msgstr "Ja&dual"

#: shutdown.cpp:133
msgid "&Force now"
msgstr "Paksa sekaran&g"

#: shutdown.cpp:134
msgid "&Try now"
msgstr "Cu&ba sekarang"

#: shutdown.cpp:145
msgid "&Logout"
msgstr "&Log keluar"

