#: kdesu.cpp:57 kdesu.cpp:58
msgid "Specifies the command to run."
msgstr "Menentukan arahan untuk dilaksanakan."

#: kdesu.cpp:59
msgid "Run command under target uid if <file> is not writable."
msgstr "Laksanakan arahan dengan uid sasaran jika <file> tidak boleh ditulis."

#: kdesu.cpp:60
msgid "Specifies the target uid."
msgstr "Tentukan uid sasaran."

#: kdesu.cpp:61
msgid "Do not keep password."
msgstr "Jangan simpan kata laluan."

#: kdesu.cpp:62
msgid "Stop the daemon (forgets all passwords)."
msgstr "Hentikan daemon (lupakan semua kata laluan)."

#: kdesu.cpp:63
msgid "Enable terminal output (no password keeping)."
msgstr "Hidupkan terminal output (tiada kata laluan disimpan)."

#: kdesu.cpp:64
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr "Tetapkan nilai keutamaan: 0 <= turutan keutamaan <= 100, 0 yang terendah."

#: kdesu.cpp:65
msgid "Use realtime scheduling."
msgstr "Guna penjadualan masa nyata."

#: kdesu.cpp:66
msgid "Let command use existing dcopserver."
msgstr "Biarkan arahan menggunakan pelayan dcop yang ada."

#: kdesu.cpp:97
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:98
msgid "Runs a program with elevated privileges."
msgstr "Laksana program dengan kebenaran tertinggi."

#: kdesu.cpp:101
msgid "Maintainer"
msgstr "Penyelenggara"

#: kdesu.cpp:103
msgid "Original author"
msgstr "Pengarang asal"

#: kdesu.cpp:121
msgid "Command '%1' not found."
msgstr "Arahan '%1' tidak ditemui."

#: kdesu.cpp:189
#, c-format
msgid "Illegal priority: %1"
msgstr "Keutamaan tidak sah: %1"

#: kdesu.cpp:217
msgid "No command specified!"
msgstr "Tiada arahan ditentukan!"

#: kdesu.cpp:322
msgid "Su returned with an error!\n"
msgstr "Su menunjukkan ralat!\n"

#: kdesu.cpp:342
msgid "Command:"
msgstr "Arahan:"

#: kdesu.cpp:347
msgid "realtime: "
msgstr "masa-nyata:"

#: kdesu.cpp:349
msgid "Priority:"
msgstr "Keutamaan:"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "Berfungsi sebagai %1"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"Aksi diminta memerlukan kebenaran khas. Sila masukkan kata laluan root "
"di bawah atau klik Abaikan untuk meneruskan kebenaran semasa."

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Aksi diminta memerlukan kebenaran khas. Sila masukkan "
"kata laluan untuk \"%1\" di bawah atau klik Abaikan untuk meneruskan kebenaran semasa."

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "Aba&i"

#: sudlg.cpp:50
msgid "Conversation with su failed."
msgstr "Perbualan dengan su gagal."

#: sudlg.cpp:59
msgid ""
"The program 'su' is not found!\n"
"Make sure your PATH is set correctly."
msgstr ""
"Program 'su' tidak ditemui!\n"
"Pastikan PATH ditetapkan dengan betul."

#: sudlg.cpp:66
msgid ""
"You are not allowed to use 'su'!\n"
"On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"Anda tidak dibenarkan menggunakan 'su'\n"
"Untuk sesetengah sistem, anda perlu berada di dalam kumpulan khas (selalunya: wheel) "
"untuk menggunakan program ini."

#: sudlg.cpp:73
msgid "Incorrect password! Please try again."
msgstr "Kata laluan salah! Cuba lagi."

#: sudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr "Ralat dalaman: Pulangan tidak sah dari SuProcess::checkInstall()"

