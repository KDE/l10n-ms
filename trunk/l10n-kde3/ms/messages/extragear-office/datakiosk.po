"[current_datetime]\n"
"[f:table.field]\n"
"\n"
"<h3>Possible Constants:</h3>\n"
"&nbsp;&nbsp;&nbsp;[#:integer]\n"
"[\"some string\"]\n"
"\n"
"<h3>Possible Operators:</h3>\n"
"&nbsp;&nbsp;&nbsp;<b>'+'</b>&nbsp;&nbsp;&nbsp;<i>addition,</i> valid for numbers and strings<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'-'</b>&nbsp;&nbsp;&nbsp;<i>subtraction,</i> valid for numbers, times, dates, and datetimes<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'*'</b>&nbsp;&nbsp;&nbsp;<i>multiplication,</i> valid for numbers<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'/'</b>&nbsp;&nbsp;&nbsp;<i>division,</i> valid for numbers<br>\n"
"\n"
"<h3>Example: </h3>\n"
"&nbsp;&nbsp;&nbsp;[current_date] - [f:table.some_other_date] + [\" days\"]"
