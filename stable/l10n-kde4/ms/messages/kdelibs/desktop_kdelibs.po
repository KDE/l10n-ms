#: interfaces/ktexteditor/kcm_ktexteditor.desktop:2
msgctxt "Name|standard desktop component"
msgid "Embedded Text Editor"
msgstr "Editor Teks Terbinadalam"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:75
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
" Servis penyunting teks yang menyediakan aplikasi dengan pelihat teks dan "
"editor. Aplikasi KDE yang menyediakan kemudahan penyuntingan teks patut "
"menggunakan servis ini."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
