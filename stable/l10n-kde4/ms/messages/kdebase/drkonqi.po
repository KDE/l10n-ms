#: debugger.cpp:141
#, kde-format
msgid ""
"A file named <filename>%1</filename> already exists. Are you sure you want "
"to overwrite it?"
msgstr ""
"Fail bernama <filename>%1</filename> telah wujud. Anda pasti anda hendak "
"menulisganti kepadanya?"

#: debugger.cpp:143
msgid "Overwrite File?"
msgstr "Tindih Fail?"

#: debugger.cpp:144
msgid "&Overwrite"
msgstr "&Tindih"

