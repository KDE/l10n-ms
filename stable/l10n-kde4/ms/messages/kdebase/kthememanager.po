msgid "Theme Files"
msgstr "Fail Tema"

#: kthememanager.cpp:266
msgid "Select Theme File"
msgstr "Pilih Fail Tema"

#: kthememanager.cpp:300
#, kde-format
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "Adakah anda benar-benar ingin membuang tema <b>%1</b>?"

#: kthememanager.cpp:301
msgid "Remove Theme"
msgstr "Buang Tema"

#: kthememanager.cpp:323
msgid "My Theme"
msgstr "Tema Saya"

#: kthememanager.cpp:334
#, kde-format
msgid "Theme %1 already exists."
msgstr "Tema %1 sudah wujud."

