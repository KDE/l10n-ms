"Adakah anda benar-benar hendak mengaktifkan \"%1\" dan \"%2\" dan "
"menyahaktifkan \"%3\"?"

#: kaccess.cpp:729
#, kde-format
msgid ""
"Do you really want to activate \"%1\", and \"%2\" and to deactivate \"%3\" "
"and \"%4\"?"
msgstr ""
"Adakah anda benar-benar hendak mengaktifkan \"%1\", dan \"%2\" dan "
"menyahaktifkan \"%3\" dan \"%4\"?"

#: kaccess.cpp:736
#, kde-format
