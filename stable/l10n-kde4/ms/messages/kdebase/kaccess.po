msgstr "Adakah anda benar-benar hendak mengaktifkan \"%1\" dan menyahaktifkan \"%2\"?"

#: kaccess.cpp:711
#, kde-format
msgid "Do you really want to activate \"%1\" and to deactivate \"%2\" and \"%3\"?"
msgstr ""
"Adakah anda benar-benar hendak mengaktifkan \"%1\" dan menyahaktifkan \"%2\" "
"dan \"%3\"?"

#: kaccess.cpp:715
#, kde-format
msgid ""
"Do you really want to activate \"%1\" and to deactivate \"%2\", \"%3\" and "
"\"%4\"?"
msgstr ""
"Adakah anda benar-benar hendak mengaktifkan \"%1\" dan menyahaktifkan \"%2"
"\", \"%3\" dan \"%4\"?"

#: kaccess.cpp:722
#, kde-format
