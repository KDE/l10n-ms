#: libs/dcraw/dcrawsettingswidget.cpp:209
#, fuzzy
msgid "Quality:"
msgstr "Imej JPEG"

#: libs/dcraw/dcrawsettingswidget.cpp:211
msgid "Bilinear interpolation"
