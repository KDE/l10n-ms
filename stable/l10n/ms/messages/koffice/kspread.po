#: xml_doc.cc:5286
#, no-c-format
msgid "REPLACE(\"abcdefghijk\";6;5;\"-\") returns \"abcde-k\""
msgstr "REPLACE(\"abcdefghijk\";6;5;\"-\") mengembalikan \"abcde-k\""

