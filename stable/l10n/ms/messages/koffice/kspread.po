msgstr "GAMMALN(Nombor)"

#. i18n: file extensions/statistical.xml line 1228
#: xml_doc.cc:4977
#, no-c-format
msgid "GAMMALN(2) returns 0"
msgstr "GAMMALN(2) mengembalikan 0"

#. i18n: file extensions/statistical.xml line 1240
#: xml_doc.cc:4983
#, no-c-format
