msgstr "EFFECT(0.08;12) sama dengan 0.083"

#. i18n: file extensions/financial.xml line 668
#: xml_doc.cc:2244
#, no-c-format
msgid "Effective interest rate"
msgstr "Kadar faedah berkesan"

