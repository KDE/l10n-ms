#. i18n: file smimeconfiguration.ui line 41
#: rc.cpp:916
#, no-c-format
msgid "If this option is selected, S/MIME certificates are validated online using the Online Certificates Status Protocol (OCSP). Fill in the URL of the OCSP responder below."
msgstr "Jika opsyen ini dipilih, sijil S/MIME disahkan dalam talian menggunakan  Protokol Status Sijil Dalam Talian (PSDT). Isikan URL pemberi respons PSDT di bawah."

#. i18n: file smimeconfiguration.ui line 49
#: rc.cpp:919
