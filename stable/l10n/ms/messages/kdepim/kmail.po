msgstr "&Algoritma penyulitan:"

#. i18n: file encryptionconfigurationdialog.ui line 61
#: rc.cpp:260
#, no-c-format
msgid "Store sent messages &encrypted"
msgstr "Stor mesej &disulitkan yang telah dihantar"

#. i18n: file encryptionconfigurationdialog.ui line 83
#: rc.cpp:274
#, no-c-format
