#: groupwise.cpp:111
msgid "Unknown path. Known paths are '/freebusy/', '/calendar/' and '/addressbook/'."
msgstr "Laluan tidak diketahui. Laluan yang diketahui adalah '/lapangsibuk/', '/kalendar/' dan '/buku alamat/'."

#: groupwise.cpp:143
msgid "Illegal filename. File has to have '.ifb' suffix."
msgstr "Nama fail tidak sah. Fail mesti ada akhiran'.ifb'."

#: groupwise.cpp:161
msgid "Need username and password."
msgstr "Nama pengguna dan kata laluan diperlukan."

#: groupwise.cpp:175
#: groupwise.cpp:221
#: groupwise.cpp:280
msgid "Unable to login."
msgstr "Tidak dapat log masuk"

#: groupwise.cpp:179
msgid "Unable to read free/busy data."
msgstr "Tidak dapat membaca data lapang/sibuk."

#: groupwise.cpp:225
msgid "Unable to read calendar data."
msgstr "Tidak dapat membaca data kalendar."

#: groupwise.cpp:253
msgid "No addressbook IDs given."
msgstr "ID buku alamat tidak diberi."

#: groupwise.cpp:284
msgid "Unable to read addressbook data."
msgstr "Tidak dapat membaca data buku alamat."

