#: faxrenderer.cpp:138
#: faxrenderer.cpp:159
#: faxrenderer.cpp:164
msgid "File Error"
msgstr "Ralat Fail "

#: faxrenderer.cpp:158
#: faxrenderer.cpp:162
msgid "<qt><strong>File error.</strong> The specified file '%1' could not be loaded.</qt>"
msgstr "<qt><strong>Ralat Fail.</strong> Fail '%1' yang dinyatakan tidak dapat dimuatkan.</qt>"

#: main.cpp:18
msgid "Check if the file is loaded in another KFaxView instance. If it is, bring up the other KFaxView. Otherwise, load the file."
msgstr "Pastikan sama ada fail dimuatkan ke dalam kejadian KPaparFaks lain. Jika ya,  bawa atas KPaparFaks lain. Jika sebaliknya, muatkan fail."

#: main.cpp:19
msgid "Sets paper size (not implemented at the moment, only for compatibility with lyx)"
msgstr "Mengeset saiz kertas (tidak dilaksanakan pada ketika ini, hanya untuk keserasasian dengan lyx)"

#: main.cpp:20
msgid "Files to load"
msgstr "Fail hendak dimuatkan"

#: main.cpp:25
msgid "A previewer for Fax files."
msgstr "Pemprapapar untuk fail Faks."

#: main.cpp:33
msgid "This program displays FAX-G3 files."
msgstr "Program ini memaparkan fail FAX-G3."

#: main.cpp:36
msgid "KViewShell plugin"
msgstr "Plugin KPaparShell"

#: main.cpp:41
msgid "Fax file loading"
msgstr "Memuatkan fail faks"

#: main.cpp:73
msgid "The URL %1 is not well-formed."
msgstr "URL %1 tidak dibentuk dengan betul."

#: main.cpp:79
msgid "The URL %1 does not point to a local file. You can only specify local files if you are using the '--unique' option."
msgstr "URL %1 tidak menuding ke fail setempat. Anda hanya boleh nyatakan fail setempat jika anda menggunakan opsyen '--unique'."

