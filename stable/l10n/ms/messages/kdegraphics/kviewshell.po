#: kviewpart.cpp:129
msgid "<qt><p>The specified library <b>%1</b> could not be loaded. The error message returned was:</p><p><b>%2</b></p></qt>"
msgstr "<qt><p>Pustaka yang dinyatakan <b>%1</b> tidak boleh dimuatkan. Mesej ralat yang dikembalikan ialah:</p><p><b>%2</b></p></qt>"

#: kviewpart.cpp:133
#: kviewpart.cpp:719
