msgid "Set Brightness to %1"
msgstr "Tetap Kecerahan ke %1"

#: PowerDevilRunner.cpp:231
msgid "Dim screen totally"
msgstr "Kelam skrin keseluruhan"

#: PowerDevilRunner.cpp:239
msgid "Dim screen by half"
msgstr "Kelam skrin separuh"

#: PowerDevilRunner.cpp:276
msgid "Suspend to RAM"
msgstr "Gantung ke RAM"

#: PowerDevilRunner.cpp:281
msgid "Suspend to Disk"
msgstr "Gantung ke Cakera"

