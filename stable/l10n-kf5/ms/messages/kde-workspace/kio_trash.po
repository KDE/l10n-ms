#: kio_trash.cpp:93 kio_trash.cpp:159 kio_trash.cpp:315 kio_trash.cpp:347
#: kio_trash.cpp:513 kio_trash.cpp:525
#, kde-format
msgid "Malformed URL %1"
msgstr "URL ralatbentuk %1"

#: kio_trash.cpp:115
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Direktori %1 tidak lagi wujud, jadi tidak mungkin untuk mengembalikan item "
"ini ke lokasi asal. Anda boleh sama ada mencipta semula direktori tersebut "
"atau guna operasi pengembalian semula, atau seret item ke tempat lain untuk "
"mengembalikannya."

#: kio_trash.cpp:144 kio_trash_win.cpp:228
msgid "This file is already in the trash bin."
msgstr "Fail ini telah ada didalam tong sampah."

#: kio_trash.cpp:233 kio_trash_win.cpp:252
msgid "Internal error in copyOrMove, should never happen"
msgstr "Ralat dalaman dalam copyOrMove, tidak sepatutnya berlaku"

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "tidak disokong"

#: ktrash.cpp:38
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Program pembantu untuk mengawal tong sampah KDE\n"
"Nota: untuk memindahkan fail ke tong sampah, jangan gunakan ktrash, tetapi "
"\"kioclient move 'url' trash:/\""

#: ktrash.cpp:41
msgid "Empty the contents of the trash"
msgstr "Kosongkan kandungan tong sampah"

#: ktrash.cpp:42
msgid "Restore a trashed file to its original location"
msgstr "Pulihkan fail dibuang ke lokasi asal"

#: trashimpl.cpp:1123
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"Sampah telah sampai ke saiz maksimum!\n"
"Bersihkan sampah secara manual."

#: trashimpl.cpp:1134
msgid "The file is too large to be trashed."
msgstr "Fail ini terlalu besar untuk dibuang ke tong sampah."

